# ---- Backend (FastAPI) --------------------------------------------------
# Server-side URL of the Just Drugs API, including /api/v1.
# The browser never sees this: Next proxies /backend/* to it.
API_URL=http://localhost:8000/api/v1

# ---- Public site --------------------------------------------------------
# Public URL of THIS frontend (used for share links, SEO, sitemap, OG images).
# On Render, RENDER_EXTERNAL_URL is used automatically if this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Just Drugs

# ---- WhatsApp ordering --------------------------------------------------
# Your pharmacy's WhatsApp number, international format, digits only.
# (08031234567 is also accepted and converted to 2348031234567.)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional contact details shown in the footer / help page
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
